SECRET_KEY=
DEBUG=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Path the Django admin is mounted at, trailing slash included. Keeping the
# real path out of the repo means automated scanners hitting /admin/ find
# nothing. MUST be set to an unguessable, non-default value in production
# (e.g. farm-admin-8f3k/). The default below is only for a bare checkout.
ADMIN_URL=admin/

# SMS (Semaphore) — texts invitation PINs to invitees and low-stock alerts
# to farm owners. Never used for login. With SMS_ENABLED unset/false, or no
# API key, notifications.sms.send_sms skips the network call and just logs
# what would have been sent — safe for local dev with nothing set below.
SEMAPHORE_API_KEY=
# Shown to the recipient as the sender; leave blank to use the account's
# registered default sender name.
SEMAPHORE_SENDER_NAME=
# Separate from the key so SMS can be switched off without removing
# credentials (e.g. rehearsing a demo repeatedly without spending credits).
SMS_ENABLED=False