SECRET_KEY=
DEBUG=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Path the Django admin is mounted at, trailing slash included. Keeping the
# real path out of the repo means automated scanners hitting /admin/ find
# nothing. MUST be set to an unguessable, non-default value in production
# (e.g. farm-admin-8f3k/). The default below is only for a bare checkout.
ADMIN_URL=admin/